  popupTitle: "\uC2A4\uD0AC \uAC15\uD654"
  popupBody: "\uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uB9C8\uB098\uC11D\uC744
    \uB4E4\uC5EC \uC2A4\uD0AC\uC744 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uAC15\uD654\uD558\uBA74
