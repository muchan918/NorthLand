  popupTitle: "\uBCF8\uC9C4 \uAC15\uD654"
  popupBody: "\uBCF8\uC9C4\uC744 \uAC15\uD654\uD558\uBA74 \uB2E4\uB978 \uAC74\uBB3C\uC758
    \uB354 \uB192\uC740 \uB808\uBCA8\uC774 \uC5F4\uB9BD\uB2C8\uB2E4.\r\n\uC0DD\uC0B0
    \uAC74\uBB3C\uACFC \uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uB294 \uBCF8\uC9C4 \uB808\uBCA8\uC774
