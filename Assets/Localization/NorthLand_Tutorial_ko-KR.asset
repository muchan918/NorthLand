  m_SharedData: {fileID: 11400000, guid: 6598b69449f7ce74ea29ec1454e5a0b9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1574342656
    m_Localized: "\uB9C8\uC6B0\uC2A4\uB85C \uD654\uBA74 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1616285696
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB978
      \uCC44 \uB04C\uBA74 \uD654\uBA74\uC774 \uB530\uB77C \uC6C0\uC9C1\uC785\uB2C8\uB2E4.\n\uBA3C
      \uACF3\uC73C\uB85C \uD55C\uBC88\uC5D0 \uC774\uB3D9\uD560 \uB54C \uD3B8\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1620480000
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C
      \uD654\uBA74\uC744 \uB04C\uC5B4 \uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2090242048
    m_Localized: "\uD654\uBA74 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 2094436352
    m_Localized: "W, A, S, D \uD0A4\uB85C \uD654\uBA74\uC744 \uC6C0\uC9C1\uC77C \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC744\uACFC \uC804\uD22C \uC9C0\uC5ED\uC744
      \uC624\uAC08 \uB54C \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2094436353
    m_Localized: "WASD \uD0A4\uB85C \uD654\uBA74\uC744 \uC6C0\uC9C1\uC5EC \uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2534838272
    m_Localized: "\uD654\uBA74 \uD655\uB300 \uCD95\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 2534838273
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uD720\uC744 \uAD74\uB824 \uD654\uBA74\uC744
      \uD655\uB300\uD558\uAC70\uB098 \uCD95\uC18C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCD95\uC18C\uD558\uBA74
      \uB9C8\uC744\uACFC \uC804\uD22C \uC9C0\uC5ED\uC744 \uD55C\uB208\uC5D0 \uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2534838274
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uD720\uB85C \uD654\uBA74\uC744 \uD655\uB300\uD558\uAC70\uB098
      \uCD95\uC18C\uD574\uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2996211712
    m_Localized: "\uC8FC\uBBFC \uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 2996211713
    m_Localized: "\uB9C8\uC744\uC5D0\uB294 \uC8FC\uBBFC\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uC8FC\uBBFC\uC744 \uC0DD\uC0B0 \uAC74\uBB3C\uC5D0 \uBC30\uCE58\uD558\uBA74
      \uB2E4\uC74C \uB0AE\uC5D0 \uADF8 \uAC74\uBB3C\uC758 \uC790\uC6D0\uC744 \uC0DD\uC0B0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2996211714
    m_Localized: "\uC8FC\uBBFC 2\uBA85\uC744 \uBAA8\uB450 \uC0DD\uC0B0 \uAC74\uBB3C\uC5D0
      \uBC30\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 3436613632
    m_Localized: "\uC804\uD22C \uC9C0\uC5ED\uC758 \uBE48 \uD0C0\uC77C\uC744 \uD074\uB9AD\uD574
      \uBC30\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 3877015552
    m_Localized: "\uD0C0\uC6CC \uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 3877015553
    m_Localized: "\uD0C0\uC6CC \uD328\uB110\uC5D0\uC11C \uBC30\uCE58\uD560 \uD0C0\uC6CC\uB97C
      \uACE0\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD0C0\uC6CC\uB9C8\uB2E4 \uBC30\uCE58
      \uBE44\uC6A9\uACFC \uACF5\uACA9 \uBC29\uC2DD\uC774 \uB2E4\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3877015554
    m_Localized: "\uD0C0\uC6CC \uD328\uB110\uC5D0\uC11C \uD0C0\uC6CC\uB97C \uD558\uB098
      \uACE0\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 4334194688
    m_Localized: "\uB0AE \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 4334194689
    m_Localized: "\uC900\uBE44\uAC00 \uB05D\uB098\uBA74 \uB0AE\uC744 \uC885\uB8CC\uD574
      \uBC24\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\uBC24\uC774 \uB418\uBA74
      \uC8FC\uBBFC \uBC30\uCE58\uAC00 \uD655\uC815\uB418\uACE0 \uD0C0\uC6CC\uAC00
      \uC790\uB3D9\uC73C\uB85C \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4.\n\uBC30\uCE58\uD558\uC9C0
      \uC54A\uC740 \uC8FC\uBBFC\uC774\uB098 \uD0C0\uC6CC\uAC00 \uC788\uC73C\uBA74
      \uADF8\uB9CC\uD07C \uC190\uD574\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4334194690
    m_Localized: "\uB0AE \uC885\uB8CC \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBC24\uC73C\uB85C
      \uB118\uC5B4\uAC00\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 5269524480
    m_Localized: "\uC2A4\uD0AC \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 5269524481
    m_Localized: "\uBC24\uC5D0\uB294 \uC2A4\uD0AC\uB85C \uC801\uC744 \uC9C1\uC811
      \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2A4\uD0AC \uBC84\uD2BC\uC744
      \uB204\uB978 \uB4A4 \uC804\uD22C \uC9C0\uC5ED\uC758 \uBAA9\uD45C \uC9C0\uC810\uC744
      \uD074\uB9AD\uD558\uBA74 \uADF8 \uC790\uB9AC\uC5D0 \uC2A4\uD0AC\uC774 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5269524482
    m_Localized: "\uC2A4\uD0AC\uC744 \uC801\uC5D0\uAC8C \uC870\uC900\uD574 \uC0AC\uC6A9\uD574
      \uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 6699782144
    m_Localized: "\uBE44\uC2A4\uCF13 \uD558\uC6B0\uC2A4 \xB7 \uCD08\uCF54\uB098\uBB34
      \xB7 \uC288\uAC00 \uD31C\uC744 \uAC01\uAC01 \uD55C \uBC88\uC529 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uC138\uC694\r\n\uD328\uB110\uC774
      \uB2EB\uD788\uBA74 \uAC74\uBB3C\uC744 \uB2E4\uC2DC \uD074\uB9AD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 7161155584
    m_Localized: "\uAC74\uBB3C \uBC14\uB85C\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7161155585
    m_Localized: "\uBBF8\uB2C8\uB9F5 \uC544\uB798 \uBC14\uB85C\uAC00\uAE30 \uBC14\uC5D0\uC11C
      \uAC74\uBB3C\uC744 \uACE0\uB974\uBA74 \uADF8 \uAC74\uBB3C\uB85C \uBC14\uB85C
      \uC774\uB3D9\uD569\uB2C8\uB2E4.\r\n\uC774\uB3D9\uACFC \uB3D9\uC2DC\uC5D0 \uAC74\uBB3C
      \uC815\uBCF4 \uD328\uB110\uC774 \uC5F4\uB824, \uB808\uBCA8\uACFC \uC5C5\uADF8\uB808\uC774\uB4DC
      \uBE44\uC6A9\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC5F0\uC2B5\uC744
      \uC704\uD574 \uC774\uBC88\uC5D0\uB294 \uC790\uC6D0 \uC5C6\uC774 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7161155586
    m_Localized: "\uBC14\uB85C\uAC00\uAE30 \uBC14\uC5D0\uC11C \uBE44\uC2A4\uCF13
      \uD558\uC6B0\uC2A4\uB97C \uB204\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 7609946112
    m_Localized: "\uD0C0\uC6CC \uD569\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 7609946113
    m_Localized: "\uAC19\uC740 \uD0C0\uC6CC\uB97C \uC5EC\uB7EC \uAC1C \uBAA8\uC73C\uBA74
      \uB354 \uAC15\uD55C \uD0C0\uC6CC\uB85C \uD569\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uD569\uC131\uD560
      \uD0C0\uC6CC\uB4E4\uC744 \uD568\uAED8 \uC120\uD0DD\uD558\uBA74 \uB9CC\uB4E4
      \uC218 \uC788\uB294 \uD0C0\uC6CC \uBAA9\uB85D\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\r\n\uC5F0\uC2B5\uC744
      \uC704\uD574 \uC774\uBC88\uC5D0\uB294 \uC544\uCC98 \uD0C0\uC6CC\uB97C \uC790\uC6D0
      \uC5C6\uC774 \uC9C0\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7614140416
    m_Localized: "\uC544\uCC98 \uD0C0\uC6CC\uB97C 3\uAC1C \uBC30\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 8046153728
    m_Localized: "\uC544\uCC98 \uD0C0\uC6CC 3\uAC1C\uB97C \uB4DC\uB798\uADF8\uB85C
      \uD568\uAED8 \uC120\uD0DD\uD558\uC138\uC694 (Shift+\uD074\uB9AD\uC73C\uB85C\uB3C4
      \uB429\uB2C8\uB2E4)\r\n\uD569\uC131 \uBAA9\uB85D\uC5D0\uC11C \uD0C0\uC6CC\uB97C
      \uACE0\uB978 \uB4A4, \uB193\uC744 \uC790\uB9AC\uB97C \uD074\uB9AD\uD558\uBA74
      \uC644\uB8CC\uB429\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 8494944256
    m_Localized: "\uB298\uC5B4\uB09C \uC8FC\uBBFC\uC744 \uC0DD\uC0B0 \uAC74\uBB3C\uC5D0
      \uBC30\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 8964706304
    m_Localized: "\uC8FC\uBBFC \uB298\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 8964706305
    m_Localized: "\uBCF8\uC9C4\uC5D0\uC11C \uC790\uC6D0\uC744 \uB4E4\uC5EC \uB9C8\uC744
      \uC8FC\uBBFC \uC218\uB97C \uB298\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC8FC\uBBFC\uC774
      \uB298\uBA74 \uC0DD\uC0B0 \uAC74\uBB3C\uC5D0 \uB354 \uBC30\uCE58\uD560 \uC218
      \uC788\uC5B4 \uD558\uB8E8 \uC0DD\uC0B0\uB7C9\uC774 \uD568\uAED8 \uC62C\uB77C\uAC11\uB2C8\uB2E4.\r\n\uC5F0\uC2B5\uC744
      \uC704\uD574 \uC774\uBC88\uC5D0\uB294 \uC790\uC6D0 \uC5C6\uC774 \uB298\uB9B4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8964706306
    m_Localized: "\uBC14\uB85C\uAC00\uAE30 \uBC14\uC5D0\uC11C \uCE90\uC2AC\uC744
      \uB20C\uB7EC \uC8FC\uBBFC\uC744 1\uBA85 \uB298\uB9AC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 9430274048
    m_Localized: "\uC2A4\uD0AC \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 9430274049
    m_Localized: "\uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uB9C8\uB098\uC11D\uC744
      \uB4E4\uC5EC \uC2A4\uD0AC\uC744 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uAC15\uD654\uD558\uBA74
      \uAC10\uC804\uC758 \uD53C\uD574\uB7C9\uACFC \uBC94\uC704\uAC00 \uCEE4\uC9C0\uACE0
      \uC7AC\uCDA9\uC804 \uAC04\uACA9\uC774 \uC9E7\uC544\uC9D1\uB2C8\uB2E4.\r\n\uB9C8\uB098\uC11D\uC740
      \uBC24 \uC6E8\uC774\uBE0C\uB97C \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4
      \uBC1B\uC2B5\uB2C8\uB2E4.\r\n\uC5F0\uC2B5\uC744 \uC704\uD574 \uC774\uBC88\uC5D0\uB294
      \uB9C8\uB098\uC11D \uC5C6\uC774 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9430274050
    m_Localized: "\uBC14\uB85C\uAC00\uAE30 \uBC14\uC5D0\uC11C \uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uB97C
      \uB20C\uB7EC \uC2A4\uD0AC\uC744 1\uB808\uBCA8 \uAC15\uD654\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 9879064576
    m_Localized: "\uC790\uC6D0 \uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 9879064577
    m_Localized: "\uC5F0\uAE08\uC220\uC0AC\uC758 \uC9D1\uC5D0\uC11C \uB9C8\uB098\uC11D\uC744
      \uB2E4\uB978 \uC790\uC6D0\uC73C\uB85C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB9C8\uB098\uC11D\uC740
      \uBC24 \uC6E8\uC774\uBE0C\uB97C \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4
      \uBC1B\uC73C\uBBC0\uB85C, \uBAA8\uC790\uB780 \uC790\uC6D0\uC744 \uBA54\uC6B0\uB294
      \uB370 \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9879064578
    m_Localized: "\uC5F0\uAE08\uC220\uC0AC\uC758 \uC9D1\uC5D0\uC11C \uC6D0\uD558\uB294
      \uC790\uC6D0\uC73C\uB85C \uAD50\uD658\uD574 \uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10348826624
    m_Localized: "\uBCF8\uC9C4 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 10348826625
    m_Localized: "\uBCF8\uC9C4\uC744 \uAC15\uD654\uD558\uBA74 \uB2E4\uB978 \uAC74\uBB3C\uC758
      \uB354 \uB192\uC740 \uB808\uBCA8\uC774 \uC5F4\uB9BD\uB2C8\uB2E4.\r\n\uC0DD\uC0B0
      \uAC74\uBB3C\uACFC \uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uB294 \uBCF8\uC9C4 \uB808\uBCA8\uC774
      \uBAA8\uC790\uB77C\uBA74 \uADF8 \uC704\uB85C \uC62C\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uB610\uD55C
      \uC5F0\uAE08\uC220\uC0AC \uC9D1\uC5D0\uC11C \uAD50\uD658\uB418\uB294 \uC790\uC6D0\uB7C9\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uC5F0\uC2B5\uC744 \uC704\uD574 \uC774\uBC88\uC5D0\uB294
      \uC790\uC6D0 \uC5C6\uC774 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10348826626
    m_Localized: "\uBC14\uB85C\uAC00\uAE30 \uBC14\uC5D0\uC11C \uCE90\uC2AC\uC744
      \uB20C\uB7EC \uBCF8\uC9C4\uC744 Lv2\uB85C \uAC15\uD654\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10818588672
    m_Localized: "\uB450 \uBC88\uC9F8 \uBC24"
    m_Metadata:
      m_Items: []
  - m_Id: 10818588673
    m_Localized: "\uC9C0\uAE08\uAE4C\uC9C0 \uAC15\uD654\uD55C \uAC83\uB4E4\uC774
      \uC2E4\uC81C\uB85C \uC5B4\uB5BB\uAC8C \uC791\uB3D9\uD558\uB294\uC9C0 \uD655\uC778\uD560
