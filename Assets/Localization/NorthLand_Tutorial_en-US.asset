  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NorthLand_Tutorial_en-US
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 6598b69449f7ce74ea29ec1454e5a0b9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1574342656
    m_Localized: Drag to Move the Camera
    m_Metadata:
      m_Items: []
  - m_Id: 1616285696
    m_Localized: Hold the right mouse button and drag to move the camera.
    m_Metadata:
      m_Items: []
  - m_Id: 1620480000
    m_Localized: Hold the right mouse button and drag to move the camera.
    m_Metadata:
      m_Items: []
  - m_Id: 2090242048
    m_Localized: Move the Camera
    m_Metadata:
      m_Items: []
  - m_Id: 2094436352
    m_Localized: Use the W, A, S, and D keys to move the camera.
    m_Metadata:
      m_Items: []
  - m_Id: 2094436353
    m_Localized: Move the camera with the WASD keys.
    m_Metadata:
      m_Items: []
  - m_Id: 2534838272
    m_Localized: Zoom In and Out
    m_Metadata:
      m_Items: []
  - m_Id: 2534838273
    m_Localized: 'Scroll the mouse wheel to zoom in or out.

      Zoom out to see
      the village and battlefield at a glance.'
    m_Metadata:
      m_Items: []
  - m_Id: 2534838274
    m_Localized: Use the mouse wheel to zoom in or out.
    m_Metadata:
      m_Items: []
  - m_Id: 2996211712
    m_Localized: Assign Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 2996211713
    m_Localized: Use the + buttons on the production lines at the bottom left to
      assign villagers.
    m_Metadata:
      m_Items: []
  - m_Id: 2996211714
    m_Localized: Use the + buttons to assign both villagers to production buildings.
    m_Metadata:
      m_Items: []
  - m_Id: 3436613632
    m_Localized: 'Click an empty tile in the battlefield to place the tower.

      Placing
      it on a buff tile grants the displayed effect.'
    m_Metadata:
      m_Items: []
  - m_Id: 3877015552
    m_Localized: Place a Tower
    m_Metadata:
      m_Items: []
  - m_Id: 3877015553
    m_Localized: 'Choose a tower to place from the tower panel.


      Each tower
      has a different placement cost and attack style.'
    m_Metadata:
      m_Items: []
  - m_Id: 3877015554
    m_Localized: Choose one tower from the tower panel.
    m_Metadata:
      m_Items: []
  - m_Id: 4334194688
    m_Localized: End the Day
    m_Metadata:
      m_Items: []
  - m_Id: 4334194689
    m_Localized: 'When you are ready, end the day to begin the night.

      At night,
      villager assignments are locked in and towers automatically attack enemies.

      Any
      villagers or towers left unused will reduce your effectiveness.'
    m_Metadata:
      m_Items: []
  - m_Id: 4334194690
    m_Localized: Place at least one tower, then press Next to begin the night.
    m_Metadata:
      m_Items: []
  - m_Id: 5269524480
    m_Localized: Use a Skill
    m_Metadata:
      m_Items: []
  - m_Id: 5269524481
    m_Localized: 'At night, you can attack enemies directly with skills.


      Select
      a skill, then click a target location in the battlefield to cast it there.'
    m_Metadata:
      m_Items: []
  - m_Id: 5269524482
    m_Localized: Aim a skill at the enemies and cast it.
    m_Metadata:
      m_Items: []
  - m_Id: 6699782144
    m_Localized: "Upgrade the Biscuit House, Choco Tree, and Sugar Farm once each.\nYou
      can also move between them with the 1\u20136 number keys.\nUpgrades are free
      during the tutorial."
    m_Metadata:
      m_Items: []
  - m_Id: 7161155584
    m_Localized: Building Shortcuts
    m_Metadata:
      m_Items: []
  - m_Id: 7161155585
    m_Localized: 'Click a building shortcut beside the minimap at the top left to
      move to that building and open its information panel.

      You can also open
      the panel by clicking the building directly.

      The panel shows the building''s
      level and upgrade cost.'
    m_Metadata:
      m_Items: []
  - m_Id: 7161155586
    m_Localized: Use the Biscuit House shortcut or click the Biscuit House directly.
    m_Metadata:
      m_Items: []
  - m_Id: 7609946112
    m_Localized: Tower Fusion
    m_Metadata:
      m_Items: []
  - m_Id: 7609946113
    m_Localized: 'Certain towers can be fused into stronger towers.


      Select
      the towers you want to use as materials to see a list of towers you can create.'
    m_Metadata:
      m_Items: []
  - m_Id: 7614140416
    m_Localized: 'Place more Archer Towers until you have three on the battlefield.

      Archer
      Towers are free to place during the tutorial.

      Press 7 to move to the
      combat area.'
    m_Metadata:
      m_Items: []
  - m_Id: 8046153728
    m_Localized: 'Drag to select all three Archer Towers together.

      You can
      also select multiple towers with Shift+Click.

      Choose a tower from the
      fusion list, then place it.'
    m_Metadata:
      m_Items: []
  - m_Id: 8494944256
    m_Localized: 'Drag the new villager to a production building.

      The tutorial
      will continue once every villager is assigned.'
    m_Metadata:
      m_Items: []
  - m_Id: 8964706304
    m_Localized: Increase Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 8964706305
    m_Localized: 'Spend resources at the Castle to increase the village population.

      More
      villagers can be assigned to production buildings, increasing your daily output.'
    m_Metadata:
      m_Items: []
  - m_Id: 8964706306
    m_Localized: 'Select the Castle and add one villager.

      It is free during
      the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 9430274048
    m_Localized: Upgrade a Skill
    m_Metadata:
      m_Items: []
  - m_Id: 9430274049
    m_Localized: 'Use Star Candy at the Magic Laboratory to upgrade your skills.

      Upgrades
      increase a skill''s damage and area while reducing its cooldown.

      You
      receive 10 Star Candy each time you clear a night wave.

      For practice,
      this upgrade is free during the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 9430274050
    m_Localized: 'Select the Magic Laboratory and upgrade a skill once.

      It
      is free during the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 9879064576
    m_Localized: Exchange Resources
    m_Metadata:
      m_Items: []
  - m_Id: 9879064577
    m_Localized: 'At the Alchemist''s House, you can exchange Star Candy for other
      resources.


      Use Star Candy to replenish resources you are short on.'
    m_Metadata:
      m_Items: []
  - m_Id: 9879064578
    m_Localized: Exchange Star Candy for any resource at the Alchemist's House.
    m_Metadata:
      m_Items: []
  - m_Id: 10348826624
    m_Localized: Upgrade the Castle
    m_Metadata:
      m_Items: []
  - m_Id: 10348826625
    m_Localized: 'Upgrading the Castle unlocks higher levels for other buildings.

      Production
      buildings and the Magic Laboratory cannot be upgraded beyond the level allowed
      by the Castle.

      It also increases the amount of resources received from
      exchanges at the Alchemist''s House.'
    m_Metadata:
      m_Items: []
  - m_Id: 10348826626
    m_Localized: 'Select the Castle and upgrade it to Lv. 2.

      It is free during
      the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 10818588672
    m_Localized: The Second Night
    m_Metadata:
      m_Items: []
  - m_Id: 10818588673
    m_Localized: 'That concludes the instructions.


      Clear the next wave to
      finish the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 10818588674
    m_Localized: Press Next to begin the night.
    m_Metadata:
      m_Items: []
  - m_Id: 11737141248
    m_Localized: First
    m_Metadata:
      m_Items: []
  - m_Id: 11737141249
    m_Localized: "Hello\t"
    m_Metadata:
      m_Items: []
  - m_Id: 11737141250
    m_Localized: Assign a villager to a building.
    m_Metadata:
      m_Items: []
  - m_Id: 12173348864
    m_Localized: Second
    m_Metadata:
      m_Items: []
  - m_Id: 12173348865
    m_Localized: Continue
    m_Metadata:
      m_Items: []
  - m_Id: 12173348866
    m_Localized: 'Remove a villager from a building.

'
    m_Metadata:
      m_Items: []
  - m_Id: 12638916608
    m_Localized: Confirm
    m_Metadata:
      m_Items: []
  - m_Id: 12638916609
    m_Localized: Cancel
    m_Metadata:
      m_Items: []
  - m_Id: 12638916610
    m_Localized: Skip Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 12638916611
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 12638916613
    m_Localized: 'Starting the tutorial will delete your current game progress.

      Would
      you like to start the tutorial?'
    m_Metadata:
      m_Items: []
  - m_Id: 606019064860672
    m_Localized: Buff Tiles
    m_Metadata:
      m_Items: []
  - m_Id: 606020335734784
    m_Localized: 'Effect icons appear on buff tiles while you are placing a tower.


      Place
      a tower on a buff tile to receive its stat bonus.'
    m_Metadata:
      m_Items: []
  - m_Id: 615170927136768
    m_Localized: Undo
    m_Metadata:
      m_Items: []
  - m_Id: 615170964885504
    m_Localized: Cancel a misplaced tower with the Undo button or Ctrl+Z.
    m_Metadata:
      m_Items: []
  - m_Id: 759725932580864
    m_Localized: Drag to Assign Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 759725970329600
    m_Localized: 'Zoom in on the village to find the marshmallow villagers.

      You
      can drag a villager directly onto a production building.

      Drag a villager
      to the production building where you want to assign them.'
    m_Metadata:
      m_Items: []
  - m_Id: 951498059452416
    m_Localized: 'Clear the wave.

      You cannot lose during the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 951498101395456
    m_Localized: 'Tutorial complete.

      The main game will begin shortly.'
    m_Metadata:
      m_Items: []
  - m_Id: 1622859966746624
    m_Localized: Welcome to the Tutorial!
    m_Metadata:
      m_Items: []
  - m_Id: 1622860000301056
    m_Localized: "We\u2019ll guide you through the basic controls and the game\u2019s
      key features.\nWhen you\u2019re ready, select Complete to begin the tutorial."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
