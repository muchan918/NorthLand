  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NorthLand_Tutorial_en-US
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 6598b69449f7ce74ea29ec1454e5a0b9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1574342656
    m_Localized: Drag to Move the Camera
    m_Metadata:
      m_Items: []
  - m_Id: 1616285696
    m_Localized: Hold the right mouse button and drag to move the camera.
    m_Metadata:
      m_Items: []
  - m_Id: 1620480000
    m_Localized: Hold the right mouse button and drag to move the camera!
    m_Metadata:
      m_Items: []
  - m_Id: 2090242048
    m_Localized: Move the Camera
    m_Metadata:
      m_Items: []
  - m_Id: 2094436352
    m_Localized: Use the W, A, S, and D keys to move the camera.
    m_Metadata:
      m_Items: []
  - m_Id: 2094436353
    m_Localized: Use the WASD keys to move the camera!
    m_Metadata:
      m_Items: []
  - m_Id: 2534838272
    m_Localized: Zoom In and Out
    m_Metadata:
      m_Items: []
  - m_Id: 2534838273
    m_Localized: 'Scroll the mouse wheel to zoom in or out.

      Zoom out to see
      the village and battlefield at a glance.'
    m_Metadata:
      m_Items: []
  - m_Id: 2534838274
    m_Localized: Use the mouse wheel to zoom in and out!
    m_Metadata:
      m_Items: []
  - m_Id: 2996211712
    m_Localized: Assign Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 2996211713
    m_Localized: "Press the + button \non the production line\nin the bottom-left
      to \nassign a resident!"
    m_Metadata:
      m_Items: []
  - m_Id: 2996211714
    m_Localized: "Press the + button to assign both residents to \nproduction buildings!"
    m_Metadata:
      m_Items: []
  - m_Id: 3436613632
    m_Localized: 'Click an empty tile in the battle area to place a tower!

      Place
      it on a Buff Tile to gain a special effect!'
    m_Metadata:
      m_Items: []
  - m_Id: 3877015552
    m_Localized: Place a Tower
    m_Metadata:
      m_Items: []
  - m_Id: 3877015553
    m_Localized: "Choose a tower to place\nfrom the Tower Panel!\n\nEach tower has
      a different\nplacement cost and \nattack style."
    m_Metadata:
      m_Items: []
  - m_Id: 3877015554
    m_Localized: Choose one tower to place from the Tower Panel!
    m_Metadata:
      m_Items: []
  - m_Id: 4334194688
    m_Localized: End the Day
    m_Metadata:
      m_Items: []
  - m_Id: 4334194689
    m_Localized: 'When you are ready, end the day to begin the night.

      At night,
      villager assignments are locked in and towers automatically attack enemies.

      Any
      villagers or towers left unused will reduce your effectiveness.'
    m_Metadata:
      m_Items: []
  - m_Id: 4334194690
    m_Localized: "Place at least one tower, then press the Next button \nin the top-right
      to move on to night!"
    m_Metadata:
      m_Items: []
  - m_Id: 5269524480
    m_Localized: Use a Skill
    m_Metadata:
      m_Items: []
  - m_Id: 5269524481
    m_Localized: "At night, you can use skills\nto attack enemies directly!\n\nPress
      the Skill \nbutton or Q,\nthen click your target \nlocation to use the skill!"
    m_Metadata:
      m_Items: []
  - m_Id: 5269524482
    m_Localized: Aim at an enemy and use your skill!
    m_Metadata:
      m_Items: []
  - m_Id: 6699782144
    m_Localized: 'Upgrade the Biscuit House, Choco Tree,

      and Sugar Farm once
      each!

      Their shortcut keys are 2, 3, and 4. Upgrades are

      free
      during the tutorial!'
    m_Metadata:
      m_Items: []
  - m_Id: 7161155584
    m_Localized: Building Shortcuts
    m_Metadata:
      m_Items: []
  - m_Id: 7161155585
    m_Localized: "Click a building icon \non the minimap\nin the top-left to move
      to \nthat building\nand open its info window!\n\nYou can also click \nthe building
      directly\nor use the 1\u20136 shortcut keys."
    m_Metadata:
      m_Items: []
  - m_Id: 7161155586
    m_Localized: Use the Biscuit House shortcut or click the Biscuit House directly.
    m_Metadata:
      m_Items: []
  - m_Id: 7609946112
    m_Localized: Tower Fusion
    m_Metadata:
      m_Items: []
  - m_Id: 7609946113
    m_Localized: 'Certain towers can be combined

      to create stronger towers!


      Select
      the towers you want to combine

      to see a list of towers you can create.'
    m_Metadata:
      m_Items: []
  - m_Id: 7614140416
    m_Localized: 'Place towers until you have 3 Archer Towers!

      Placement is
      free during the tutorial.

      Press 7 to move to the battle area.'
    m_Metadata:
      m_Items: []
  - m_Id: 8046153728
    m_Localized: 'Drag to select all three Archer Towers together.

      You can
      also select multiple towers with Shift+Click.

      Choose a tower from the
      fusion list, then place it.'
    m_Metadata:
      m_Items: []
  - m_Id: 8494944256
    m_Localized: "Drag the new resident to a production buildingand \nassign them!\nYou
      can also use the + button on the production line."
    m_Metadata:
      m_Items: []
  - m_Id: 8964706304
    m_Localized: Increase Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 8964706305
    m_Localized: "Use Sugar at the Castle\nto increase \nthe number of residents!\n\nMore
      residents can \nbe assigned\nto production buildings,\nincreasing your daily
      \nproduction!"
    m_Metadata:
      m_Items: []
  - m_Id: 8964706306
    m_Localized: "Select the Castle and add one resident!\nIt\u2019s free during
      the tutorial. The shortcut key is 1."
    m_Metadata:
      m_Items: []
  - m_Id: 9430274048
    m_Localized: Upgrade a Skill
    m_Metadata:
      m_Items: []
  - m_Id: 9430274049
    m_Localized: "Use Star Candy at the Magic Lab\nto upgrade your skill!\nUpgrading
      increases \nits damage\nand range while reducing \nits cooldown.\n\nYou\u2019ll
      earn 10 Star Candy\neach time you \nclear a night wave!"
    m_Metadata:
      m_Items: []
  - m_Id: 9430274050
    m_Localized: "Select the Magic Lab and upgrade your skill once!\nIt\u2019s free
      during the tutorial.\nThe Magic Lab\u2019s shortcut key is 5."
    m_Metadata:
      m_Items: []
  - m_Id: 9879064576
    m_Localized: Exchange Resources
    m_Metadata:
      m_Items: []
  - m_Id: 9879064577
    m_Localized: "At the Alchemist\u2019s House,\nyou can exchange Star Candy\nfor
      other resources!\n\nUse Star Candy to \nmake up\nfor any resources \nyou\u2019re
      short on."
    m_Metadata:
      m_Items: []
  - m_Id: 9879064578
    m_Localized: "Exchange Star Candy for the resource you want\nat the Alchemist\u2019s
      House!\nThe shortcut key for the Alchemist\u2019s House is 6."
    m_Metadata:
      m_Items: []
  - m_Id: 10348826624
    m_Localized: Upgrade the Castle
    m_Metadata:
      m_Items: []
  - m_Id: 10348826625
    m_Localized: "Upgrade the Castle \nto unlock\nhigher levels for \nother buildings!\n\nIt
      also increases \nthe amount of resources\nyou can exchange at \nthe Alchemist\u2019s
      House."
    m_Metadata:
      m_Items: []
  - m_Id: 10348826626
    m_Localized: "Select the Castle and upgrade it to Lv.2!\nIt\u2019s free during
      the tutorial. The shortcut key is 1."
    m_Metadata:
      m_Items: []
  - m_Id: 10818588672
    m_Localized: The Second Night
    m_Metadata:
      m_Items: []
  - m_Id: 10818588673
    m_Localized: 'That concludes the instructions.


      Clear the next wave to
      finish the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 10818588674
    m_Localized: Press the Next button to move on to night!
    m_Metadata:
      m_Items: []
  - m_Id: 11737141248
    m_Localized: First
    m_Metadata:
      m_Items: []
  - m_Id: 11737141249
    m_Localized: "Hello\t"
    m_Metadata:
      m_Items: []
  - m_Id: 11737141250
    m_Localized: Assign a villager to a building.
    m_Metadata:
      m_Items: []
  - m_Id: 12173348864
    m_Localized: Second
    m_Metadata:
      m_Items: []
  - m_Id: 12173348865
    m_Localized: Continue
    m_Metadata:
      m_Items: []
  - m_Id: 12173348866
    m_Localized: 'Remove a villager from a building.

'
    m_Metadata:
      m_Items: []
  - m_Id: 12638916608
    m_Localized: Confirm
    m_Metadata:
      m_Items: []
  - m_Id: 12638916609
    m_Localized: Cancel
    m_Metadata:
      m_Items: []
  - m_Id: 12638916610
    m_Localized: Skip Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 12638916611
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 12638916613
    m_Localized: 'Starting the tutorial will delete your current game progress.

      Would
      you like to start the tutorial?'
    m_Metadata:
      m_Items: []
  - m_Id: 606019064860672
    m_Localized: Buff Tiles
    m_Metadata:
      m_Items: []
  - m_Id: 606020335734784
    m_Localized: "When placing a tower, effect icons\nappear on Buff Tiles.\n\nPlace
      a tower on \na Buff Tile\nto gain its stat bonus!"
    m_Metadata:
      m_Items: []
  - m_Id: 615170927136768
    m_Localized: Undo
    m_Metadata:
      m_Items: []
  - m_Id: 615170964885504
    m_Localized: "If you place or combine \na tower by mistake,\nor use the wrong\nresources,\nyou
      can undo it with \nthe Undo button\nor Ctrl+Z!"
    m_Metadata:
      m_Items: []
  - m_Id: 759725932580864
    m_Localized: Drag to Assign Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 759725970329600
    m_Localized: "Zoom in on the village \nto find the Marshmallow \nresidents!\n\nDrag
      a resident directly to\nthe production \nbuilding you want\nto assign them
      to!"
    m_Metadata:
      m_Items: []
  - m_Id: 951498059452416
    m_Localized: "Clear the wave to the end!\nDon\u2019t worry you can\u2019t lose
      during the tutorial."
    m_Metadata:
      m_Items: []
  - m_Id: 951498101395456
    m_Localized: "You\u2019ve completed the tutorial!\nThe main game will begin shortly."
    m_Metadata:
      m_Items: []
  - m_Id: 1622859966746624
    m_Localized: Welcome to the Tutorial!
    m_Metadata:
      m_Items: []
  - m_Id: 1622860000301056
    m_Localized: "Welcome!\n\nLet\u2019s go over how to play,\none step at a time!\n\nWhen
      you\u2019re ready, press the Confirm button\nand let\u2019s get started!"
    m_Metadata:
      m_Items: []
  - m_Id: 1631492708405248
    m_Localized: Battle Map
    m_Metadata:
      m_Items: []
  - m_Id: 1631492737765376
    m_Localized: "This is where you \ndefend against\nthe monsters that attack \nevery
      night!"
    m_Metadata:
      m_Items: []
  - m_Id: 2903649488900096
    m_Localized: Game Speed
    m_Metadata:
      m_Items: []
  - m_Id: 2903649530843136
    m_Localized: "Press the shoe icon \nnext to the minimap\nto speed up the game
      \nby 2x!\n\nYou can also press \nthe Spacebar\nto switch to 2x speed."
    m_Metadata:
      m_Items: []
  - m_Id: 2903649530843137
    m_Localized: Tower Attack Settings
    m_Metadata:
      m_Items: []
  - m_Id: 2903649530843138
    m_Localized: "Select a tower to change\nits attack style!\n\nTry selecting \ndifferent
      towers\nand using different\nattack styles!"
    m_Metadata:
      m_Items: []
  - m_Id: 2903649530843139
    m_Localized: Tower Codex
    m_Metadata:
      m_Items: []
  - m_Id: 2903649530843140
    m_Localized: "There\u2019s an encyclopedia \nwhere you can check\ntower stats
      and \ncombination info!\n\nIf there\u2019s something \nyou\u2019re curious
      about,\nlook it up in the \nencyclopedia!"
    m_Metadata:
      m_Items: []
  - m_Id: 2906405796745216
    m_Localized: Feature Overview Complete
    m_Metadata:
      m_Items: []
  - m_Id: 2906405826105344
    m_Localized: "You\u2019ve learned all the core features!\n\nNow, let\u2019s take
      a look at\na few extra features\nthat will help you out!"
    m_Metadata:
      m_Items: []
  - m_Id: 2907969739460608
    m_Localized: Production Building Upgrades
    m_Metadata:
      m_Items: []
  - m_Id: 2907969764626432
    m_Localized: "Upgrade production \nbuildings to\nincrease the resources \nyou
      earn\nfrom clearing waves!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
