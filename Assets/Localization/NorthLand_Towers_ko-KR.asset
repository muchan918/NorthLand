      m_Items: []
  - m_Id: 1254258907979776
    m_Localized: "\uCD08\uCF54 \uD3ED\uD3EC \uC9C0\uB300 \uC0DD\uC131\n\uCD08\uCF54
      \uD3ED\uD3EC \uC9C0\uB300\uB97C \uC9C0\uB098\uB294 \uC801\uC740 \uAC10\uC18D\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 1256596360044544
    m_Localized: "\uC18C\uB2E4 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1256598117457920
    m_Localized: "\uC801 \uC2A4\uD134 \uC0C1\uD0DC\uC774\uC0C1 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1256599816151040
    m_Localized: "\uC801\uC5D0\uAC8C \uC9E7\uC740 \uC2A4\uD134\uC0C1\uD0DC\uC774\uC0C1\uC744
      \uBD80\uC5EC\uD558\uC5EC \n\uC801\uC758 \uC804\uC9C4\uC744 \uBC29\uD574\uD558\uB294
      \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5373136235831296
    m_Localized: "\uD654\uC5FC \uAD81\uC218 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5373136273580032
    m_Localized: "\uB2E8\uC77C \uB300\uC0C1 \uC9C0\uC18D \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 5373136273580033
    m_Localized: "\uC0AC\uAC70\uB9AC \uB0B4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744
      \uBD88\uD654\uC0B4\uB85C \uACF5\uACA9\uD558\uACE0 2\uCD08\uAC04 \uD654\uC0C1
      \uD53C\uD574\uB97C \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 5391670919733248
    m_Localized: "\uC18C\uC774\uD0C4 \uB300\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 5391670940704768
    m_Localized: "\uAD11\uC5ED \uD654\uC0C1 \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 5391670940704769
    m_Localized: "\uC608\uCE21 \uC9C0\uC810\uC5D0 \uD3EC\uD0C4 \uB099\uD558\n\uCC29\uD0C4
      \uBC18\uACBD\uC758 \uC801 \uC804\uC6D0\uC5D0\uAC8C \uD53C\uD574\uC640 \uD654\uC0C1
      \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 5393806898405376
    m_Localized: "\uD654\uC5FC \uC9C0\uB300 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5393806898405377
    m_Localized: "\uC801 \uD654\uC0C1 \uC0C1\uD0DC\uC774\uC0C1 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 5393806898405378
    m_Localized: "\uBD88\uBC14\uB2E4 \uC9C0\uB300 \uC0DD\uC131\n\uBD88\uBC14\uB2E4\uB97C
      \uC9C0\uB098\uB294 \uC801\uC5D0\uAC8C \uD654\uC0C1 \uB370\uBBF8\uC9C0 \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874338476032
    m_Localized: "\uC0B0\uD0C4 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641856
    m_Localized: "\uADFC\uC811 \uC18C\uD0D5"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641857
    m_Localized: "\uBD80\uCC44\uAF34\uB85C \uC5EC\uB7EC \uBC1C\uC744 \uB3D9\uC2DC\uC5D0
      \uBC1C\uC0AC\uD574 \uADFC\uAC70\uB9AC\uC758 \uC801\uC744 \uD55C\uAEBC\uBC88\uC5D0
      \uD0C0\uACA9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641858
    m_Localized: "\uBD80\uBA54\uB791 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641859
    m_Localized: "\uAD00\uD1B5 \uD0C0\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641860
    m_Localized: "\uB358\uC9C4 \uBC29\uD5A5\uC73C\uB85C \uB098\uAC14\uB2E4 \uB418\uB3CC\uC544\uC624\uBA70
      \uACBD\uB85C \uC704\uC758 \uC801\uC744 \uAD00\uD1B5\uD574 \uC5EC\uB7EC \uBC88
      \uD0C0\uACA9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641861
    m_Localized: "\uBA40\uD2F0 \uC778\uD398\uB974\uB178 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641862
    m_Localized: "\uB2E4\uC911 \uC9C0\uC18D\uB51C"
    m_Metadata:
      m_Items: []
  - m_Id: 5956874363641863
    m_Localized: "\uC0AC\uAC70\uB9AC \uB0B4 \uC5EC\uB7EC \uC801\uC744 \uB3D9\uC2DC\uC5D0
      \uC7A0\uADF8\uACE0 \uC9C0\uC18D\uC801\uC73C\uB85C \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6166220603301888
    m_Localized: "\uB7A8\uD504\uC5C5 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 6166220632662016
    m_Localized: "\uC131\uC7A5\uD615 \uC18D\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6166220632662017
    m_Localized: "\uBA85\uC911\uD560 \uB54C\uB9C8\uB2E4 \uACF5\uACA9 \uC18D\uB3C4\uAC00
      \uBE68\uB77C\uC9C4\uB2E4. \uACC4\uC18D \uB9DE\uD788\uBA74 \uCD5C\uB300 +80%\uAE4C\uC9C0
      \uC624\uB974\uACE0, 2\uCD08\uAC04 \uB193\uCE58\uBA74 \uD55C \uB2E8\uACC4\uC529
      \uC2DD\uC73C\uBA70 \uC6E8\uC774\uBE0C\uAC00 \uB05D\uB098\uBA74 \uCD08\uAE30\uD654\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6203434620067840
    m_Localized: "\uC0AC\uB0E5\uAFBC \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 6203434653622272
    m_Localized: "\uC131\uC7A5\uD615 \uC800\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 6203434653622273
    m_Localized: "\uC801\uC744 \uCC98\uCE58\uD560 \uB54C\uB9C8\uB2E4 \uACF5\uACA9\uB825\uC774
      \uC624\uB978\uB2E4. \uCC98\uCE58\uB2F9 +15%, 8\uCC98\uCE58\uC5D0\uC11C 2.2\uBC30\uAC00
      \uB418\uBA70 \uC6E8\uC774\uBE0C\uAC00 \uB05D\uB098\uBA74 \uCD08\uAE30\uD654\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
