  - m_Id: 8964706304
    m_Localized: "\u4F4F\u6C11\u3092\u5897\u3084\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 8964706305
    m_Localized: "\u30AD\u30E3\u30C3\u30B9\u30EB\u3067\u7802\u7CD6\u3092\u4F7F\u3063\u3066\n\u4F4F\u6C11\u306E\u6570\u3092\u5897\u3084\u3059\u3053\u3068\u304C\n\u3067\u304D\u307E\u3059\uFF01\n\n\u4F4F\u6C11\u304C\u5897\u3048\u308B\u3068\u751F\u7523\u65BD\u8A2D\u306B\n\u3088\u308A\u591A\u304F\u914D\u7F6E\u3067\u304D\u308B\n\u3088\u3046\u306B\u306A\u308A\u3001\n1\u65E5\u306E\u751F\u7523\u91CF\u3082\u5897\u3048\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8964706306
    m_Localized: "\u30AD\u30E3\u30C3\u30B9\u30EB\u3092\u9078\u3093\u3067\u3001\u4F4F\u6C11\u30921\u4EBA\u5897\u3084\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3067\u306F\u7121\u6599\u3067\u5897\u3084\u305B\u307E\u3059\u3002\n\u30B7\u30E7\u30FC\u30C8\u30AB\u30C3\u30C8\u30AD\u30FC\u306F1\u3067\u3059\u3002"
