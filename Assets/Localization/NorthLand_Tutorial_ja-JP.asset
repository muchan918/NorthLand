    m_Localized: "\u6226\u95D8\u30A8\u30EA\u30A2\u306E\u7A7A\u3044\u3066\u3044\u308B\u30BF\u30A4\u30EB\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u3001\n\u30BF\u30EF\u30FC\u3092\u914D\u7F6E\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01\n\u30D0\u30D5\u30BF\u30A4\u30EB\u306B\u914D\u7F6E\u3059\u308B\u3068\u3001\u7279\u5225\u306A\u52B9\u679C\u3092\u53D7\u3051\u3089\u308C\u307E\u3059\u3002"
